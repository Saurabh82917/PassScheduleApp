@model PassScheduleApp.Models.PassScheduleFilterViewModel
@{
    ViewData["Title"] = "Pass Schedule";
    var selectedCoil = Model.SelectedCoilData;
}

<div class="pass-schedule-screen">
    <div class="screen-heading">
        <div>
            <p class="screen-kicker">MILL 4 <span></span> PRODUCTION CONTROL</p>
            <h1>Pass Schedule</h1>
        </div>
        <div class="screen-date">LIVE SCHEDULE</div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success app-alert" role="status"><span class="alert-symbol">&#10003;</span> @successMessage</div>
    }

    <form asp-action="Index" method="get" class="filter-panel mb-4">
        <div class="section-heading">
            <div>
                <span class="section-index">01</span>
                <h2>Find schedule</h2>
            </div>
            <span class="section-caption">Filter by coil or production date</span>
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="CoilId" class="form-label"></label>
                <input asp-for="CoilId" class="form-control" placeholder="Enter Coil Id" />
            </div>
            <div class="col-md-4">
                <label asp-for="SelectedDate" class="form-label"></label>
                <input asp-for="SelectedDate" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100 filter-button"><span aria-hidden="true">&#8981;</span> Apply Filter</button>
            </div>
        </div>
    </form>

    @if (Model.CoilOptions.Any() || !string.IsNullOrWhiteSpace(Model.SelectedCoilId))
    {
        <form asp-action="SaveEdit" method="post" class="mb-4">
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "Please review the highlighted fields.", new { @class = "validation-summary-errors app-validation-summary" })
            <input type="hidden" asp-for="CoilId" />
            <input type="hidden" asp-for="SelectedDate" />
            <input type="hidden" asp-for="RowActionPerformed" />

            <section class="selected-coil-panel mb-4" aria-labelledby="selectedCoilTitle">
                <div class="section-heading">
                    <div>
                        <span class="section-index">02</span>
                        <h2 id="selectedCoilTitle">Selected Coil</h2>
                    </div>
                    <span class="section-caption">Choose a coil to view its schedule</span>
                </div>
                <div class="coil-selector-row">
                    <div class="coil-select-field">
                        <label asp-for="SelectedCoilId" class="form-label"></label>
                        <select asp-for="SelectedCoilId" asp-items="Model.CoilOptions" class="form-select">
                            <option value="">-- Select Coil --</option>
                        </select>
                        <span asp-validation-for="SelectedCoilId" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="input-data-panel mb-4" aria-labelledby="inputDataTitle">
                <div class="section-heading">
                    <div>
                        <span class="section-index">03</span>
                        <h2 id="inputDataTitle">Input data</h2>
                    </div>
                    <span class="coil-chip">@(selectedCoil?.CoilId ?? "NO COIL SELECTED")</span>
                </div>
                <div class="input-data-grid">
                    <div class="data-field"><label for="selectedCoilInfo">Coil ID</label><input id="selectedCoilInfo" value="@selectedCoil?.CoilId" readonly /></div>
                    <div class="data-field"><label for="selectedTdcInfo">TDC</label><input id="selectedTdcInfo" value="@selectedCoil?.Tdc" readonly /></div>
                    <div class="data-field"><label for="selectedWidthInfo">Width</label><input id="selectedWidthInfo" value="@selectedCoil?.Width" readonly /></div>
                    <div class="data-field"><label for="selectedInputThicknessInfo">Input Thickness</label><input id="selectedInputThicknessInfo" value="@selectedCoil?.InputThickness" readonly /></div>
                    <div class="data-field"><label for="selectedWeightInfo">Weight</label><input id="selectedWeightInfo" value="@selectedCoil?.Weight" readonly /></div>
                    <div class="data-field"><label for="selectedRollingCountInfo">No. of Rolling</label><input id="selectedRollingCountInfo" value="@selectedCoil?.NoOfRolling" readonly /></div>
                    <div class="data-field output-thickness-field"><label for="selectedOutputThicknessInfo">Output Thickness</label><input id="selectedOutputThicknessInfo" value="@selectedCoil?.OutputThickness" readonly /></div>
                </div>
            </section>

            <div class="row g-4">
                <div class="col-12">
                    <div class="table-card">
                        <div class="table-heading">
                            <div><span class="section-index">04</span><h2 class="table-title">T_PASS_SCHEDULE_OUTPUT</h2></div>
                            <span class="table-mode">READ ONLY</span>
                        </div>
                        @if (Model.OutputRows.Count == 0)
                        {
                            <div class="empty-state">No records found for the selected coil.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Pass No</th>
                                            <th>Entry MM</th>
                                            <th>Exit MM</th>
                                            <th>Draft MM</th>
                                            <th>Reduction %</th>
                                            <th>Back Tension KG</th>
                                            <th>Front Tension KG</th>
                                            <th>Speed MPM</th>
                                            <th>Force T</th>
                                            <th>Power KW</th>
                                            <th>Gap MM</th>
                                            <th>ML Conf</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Model.OutputRows)
                                        {
                                            <tr>
                                                <td>@row.PassNo</td>
                                                <td>@row.EntryMm</td>
                                                <td>@row.ExitMm</td>
                                                <td>@row.DraftMm</td>
                                                <td>@row.ReductionPct</td>
                                                <td>@row.BackTensionKg</td>
                                                <td>@row.FrontTensionKg</td>
                                                <td>@row.SpeedMpm</td>
                                                <td>@row.ForceT</td>
                                                <td>@row.PowerKw</td>
                                                <td>@row.GapMm</td>
                                                <td>@row.MlConf</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-12">
                    <div class="table-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="table-heading">
                                <div><span class="section-index">05</span><h2 class="table-title">T_PASS_SCHEDULE_OUTPUT_EDIT</h2></div>
                                <span class="table-mode editable-mode">EDITABLE</span>
                            </div>
                            <button type="button" class="btn btn-outline-primary add-row-button" id="addPassRow"><span aria-hidden="true">+</span> Add row</button>
                        </div>
                        @if (Model.EditRows.Count == 0)
                        {
                            <div class="empty-state" id="emptyEditState">No edit rows found for the selected coil. Add a row to begin.</div>
                        }
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle mb-0 editable-table">
                                    <thead>
                                        <tr>
                                            <th>Action</th>
                                            <th>Pass No</th>
                                            <th>Entry MM</th>
                                            <th>Exit MM</th>
                                            <th>Draft MM</th>
                                            <th>Reduction %</th>
                                            <th>Back Tension KG</th>
                                            <th>Front Tension KG</th>
                                            <th>Speed MPM</th>
                                            <th>Force T</th>
                                            <th>Power KW</th>
                                            <th>Gap MM</th>
                                            <th>ML Conf</th>
                                            <th>Remark</th>
                                        </tr>
                                    </thead>
                                    <tbody id="editRowsBody">
                                        @for (var i = 0; i < Model.EditRows.Count; i++)
                                        {
                                            var row = Model.EditRows[i];
                                            <tr data-is-new="@row.IsNew.ToString().ToLowerInvariant()">
                                                <td><button type="button" class="btn btn-outline-danger btn-sm delete-pass-row">Delete</button></td>
                                                <td>
                                                    <input asp-for="EditRows[i].PassNo" class="form-control pass-no-input" type="number" min="1" required />
                                                    <input type="hidden" asp-for="EditRows[i].RunId" />
                                                    <input type="hidden" asp-for="EditRows[i].RequestId" />
                                                    <input type="hidden" asp-for="EditRows[i].CoilId" />
                                                    <input type="hidden" asp-for="EditRows[i].Tdc" />
                                                    <input type="hidden" asp-for="EditRows[i].OriginalPassNo" />
                                                    <input type="hidden" asp-for="EditRows[i].IsNew" />
                                                    <input type="hidden" asp-for="EditRows[i].AchSpeedMpm" />
                                                    <input type="hidden" asp-for="EditRows[i].GaugeRisk" />
                                                </td>
                                                <td><input asp-for="EditRows[i].EntryMm" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].ExitMm" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].DraftMm" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].ReductionPct" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].BackTensionKg" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].FrontTensionKg" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].SpeedMpm" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].ForceT" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].PowerKw" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].GapMm" class="form-control" /></td>
                                                <td><input asp-for="EditRows[i].MlConf" class="form-control" /></td>
                                                <td>
                                                    <input asp-for="EditRows[i].Remark" class="form-control remark-input" required />
                                                    <span asp-validation-for="EditRows[i].Remark" class="text-danger"></span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                            </table>
                        </div>
                        <div class="overall-remark-field mt-3">
                            <label asp-for="OverallRemark" class="form-label"></label>
                            <div class="overall-remark-actions">
                                <input asp-for="OverallRemark" class="form-control" maxlength="500" disabled="@(!Model.RowActionPerformed)" />
                                <button type="submit" class="btn btn-success save-button"><span aria-hidden="true">&#10003;</span> Save changes</button>
                            </div>
                            <span asp-validation-for="OverallRemark" class="text-danger"></span>
                            <span id="overallRemarkHint" class="text-muted d-none">Overall remark is required after adding or deleting a row.</span>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            var editForm = $('#addPassRow').closest('form');

            editForm.find('[name="SelectedCoilId"]').on('change', function () {
                var query = new URLSearchParams();
                var coilFilter = editForm.find('[name="CoilId"]').val();
                var dateFilter = editForm.find('[name="SelectedDate"]').val();

                if (coilFilter) query.set('coilId', coilFilter);
                if (dateFilter) query.set('selectedDate', dateFilter);
                if (this.value) query.set('selectedCoilId', this.value);

                window.location.assign('/?' + query.toString());
            });

            function markRowAction() {
                editForm.find('[name="RowActionPerformed"]').val('true');
                editForm.find('[name="OverallRemark"]').prop('disabled', false).attr('required', 'required');
                $('#overallRemarkHint').removeClass('d-none');
            }

            if (editForm.find('[name="RowActionPerformed"]').val() === 'true') {
                markRowAction();
            }

            function hasOverallRemark() {
                var rowActionPerformed = editForm.find('[name="RowActionPerformed"]').val() === 'true';
                if (!rowActionPerformed) return true;

                var remark = editForm.find('[name="OverallRemark"]');
                if (!remark.val() || !remark.val().trim()) {
                    remark.addClass('is-invalid').trigger('focus');
                    alert('Overall remark is required after adding or deleting a row.');
                    return false;
                }
                remark.removeClass('is-invalid');
                return true;
            }

            function renumberRows() {
                $('#editRowsBody tr').each(function (index) {
                    $(this).find('[name]').each(function () {
                        var name = $(this).attr('name');
                        if (name) {
                            $(this).attr('name', name.replace(/EditRows\[\d+\]/, 'EditRows[' + index + ']'));
                        }
                    });
                    $(this).find('[id]').each(function () {
                        var id = $(this).attr('id');
                        if (id) {
                            $(this).attr('id', id.replace(/EditRows_\d+__/, 'EditRows_' + index + '__'));
                        }
                    });
                });
            }

            function createEmptyRow(index, passNo) {
                var selectedOption = editForm.find('[name="SelectedCoilId"] option:selected');
                var coilId = selectedOption.val() || '';
                var tdc = selectedOption.text().split('|')[1]?.trim() || '';
                var row = $('<tr data-is-new="true"></tr>');
                row.append($('<td>').append($('<button>', { type: 'button', class: 'btn btn-outline-danger btn-sm delete-pass-row', text: 'Delete' })));

                var passCell = $('<td>');
                passCell.append($('<input>', { name: 'EditRows[' + index + '].PassNo', id: 'EditRows_' + index + '__PassNo', class: 'form-control pass-no-input', type: 'number', min: 1, required: true, val: passNo }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].RunId', value: 'NEW' }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].RequestId', value: '' }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].CoilId', value: coilId }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].Tdc', value: tdc }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].OriginalPassNo', value: '' }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].IsNew', value: 'true' }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].AchSpeedMpm', value: '' }));
                passCell.append($('<input>', { type: 'hidden', name: 'EditRows[' + index + '].GaugeRisk', value: '' }));
                row.append(passCell);

                [
                    ['EntryMm', false], ['ExitMm', false], ['DraftMm', false], ['ReductionPct', false],
                    ['BackTensionKg', false], ['FrontTensionKg', false], ['SpeedMpm', false],
                    ['ForceT', false], ['PowerKw', false], ['GapMm', false], ['MlConf', false]
                ].forEach(function (field) {
                    var property = field[0];
                    var input = $('<input>', {
                        name: 'EditRows[' + index + '].' + property,
                        id: 'EditRows_' + index + '__' + property,
                        class: 'form-control' + (field[1] ? ' bg-light' : ''),
                        readonly: field[1]
                    });
                    row.append($('<td>').append(input));
                });

                var remark = $('<input>', { name: 'EditRows[' + index + '].Remark', id: 'EditRows_' + index + '__Remark', class: 'form-control remark-input', maxlength: 500, required: true, val: editForm.find('[name="OverallRemark"]').val().trim() });
                row.append($('<td>').append(remark));
                return row;
            }

            editForm.on('input', '[name="OverallRemark"]', function () {
                var remark = $(this).val().trim();
                $('#editRowsBody tr[data-is-new="true"] .remark-input').each(function () {
                    if (!$(this).val().trim()) $(this).val(remark);
                });
            });

            $('#addPassRow').on('click', function () {
                markRowAction();

                var rows = $('#editRowsBody tr');
                var maxPassNo = 0;
                rows.find('.pass-no-input').each(function () {
                    maxPassNo = Math.max(maxPassNo, parseInt($(this).val(), 10) || 0);
                });

                var newRow = rows.length ? rows.last().clone() : createEmptyRow(0, maxPassNo + 1);
                if (rows.length) {
                    newRow.attr('data-is-new', 'true');
                    newRow.find('input').each(function () {
                        var input = $(this);
                        if (input.attr('name') && input.attr('name').endsWith('.RunId')) input.val('NEW');
                        else if (input.attr('name') && input.attr('name').endsWith('.RequestId')) input.val('');
                        else if (input.attr('name') && (input.attr('name').endsWith('.AchSpeedMpm') || input.attr('name').endsWith('.GaugeRisk'))) input.val('');
                        else if (input.attr('name') && input.attr('name').endsWith('.OriginalPassNo')) input.val('');
                        else if (input.attr('name') && input.attr('name').endsWith('.IsNew')) input.val('true');
                        else if (input.hasClass('pass-no-input')) input.val(maxPassNo + 1);
                        else if (input.attr('name') && input.attr('name').endsWith('.Remark')) input.val(editForm.find('[name="OverallRemark"]').val().trim());
                        else if (!input.is('[type="hidden"]')) input.val('');
                    });
                }
                $('#editRowsBody').append(newRow);
                $('#emptyEditState').hide();
                renumberRows();
            });

            editForm.on('click', '.delete-pass-row', function () {
                markRowAction();

                var row = $(this).closest('tr');
                if (row.attr('data-is-new') !== 'true') {
                    var index = editForm.find('[name^="DeletedRows["]').length / 2;
                    var runId = row.find('input[name$=".RunId"]').val();
                    var originalPassNo = row.find('input[name$=".OriginalPassNo"]').val();
                    editForm.append('<input type="hidden" name="DeletedRows[' + index + '].RunId" value="' + $('<div>').text(runId).html() + '">' +
                        '<input type="hidden" name="DeletedRows[' + index + '].OriginalPassNo" value="' + $('<div>').text(originalPassNo).html() + '">');
                }
                row.remove();
                renumberRows();
                if ($('#editRowsBody tr').length === 0) $('#emptyEditState').show();
            });

            editForm.on('submit', function (event) {
                if (!hasOverallRemark()) event.preventDefault();
            });
        });
    </script>
}
